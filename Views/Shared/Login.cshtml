@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - RiskPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/riskportal.css" />
</head>
<body>
    <div class="container-fluid p-0 login-container">
        <div class="row g-0 h-100">
            <!-- Left Side: Form -->
            <div class="col-lg-5 login-left p-5">
                <div class="w-100" style="max-width: 400px;">
                    <div class="mb-5 text-center">
                        <h2 class="fw-bold" style="color: var(--rp-orange);"><i class="bi bi-shield-check"></i> RiskPortal</h2>
                        <p class="text-muted-soft">Ingresa tus credenciales para continuar</p>
                    </div>
                    
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-muted-soft"></i></span>
                                <input type="email" class="form-control bg-light border-0 py-2" placeholder="ejemplo@empresa.com" required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-lock text-muted-soft"></i></span>
                                <input type="password" class="form-control bg-light border-0 py-2" placeholder="••••••••" required>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted-soft" for="rememberMe">Recordarme</label>
                            </div>
                            <a href="#" class="text-decoration-none" style="color: var(--rp-orange);">¿Olvidó su contraseña?</a>
                        </div>
                        <button type="submit" class="btn btn-primary-orange w-100 py-2 rounded-3">Ingresar al Sistema</button>
                    </form>
                </div>
            </div>
            
            <!-- Right Side: Graphic -->
            <div class="col-lg-7 login-right d-none d-lg-flex p-5 text-center">
                <h1 class="fw-bold mb-3">Evaluación Inteligente</h1>
                <p class="fs-5 text-light opacity-75 mb-5">Agiliza las solicitudes de crédito con análisis de riesgo en tiempo real.</p>
                <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&q=80&w=800" alt="Mockup" class="login-mockup">
            </div>
        </div>
    </div>
</body>
</html>