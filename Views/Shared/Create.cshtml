@model RiskPortal.Models.CreateSolicitudViewModel

@{
    ViewData["Title"] = "Crear Solicitud de Crédito";
}

<h2>Crear Solicitud de Crédito</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label"></label>
                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.Clientes">
                    <option value="">-- Seleccione un Cliente --</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="MontoSolicitado" class="control-label"></label>
                <input asp-for="MontoSolicitado" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-4">
                <input type="submit" value="Registrar Solicitud" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver al Catálogo</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}