@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpAccessor
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RiskPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/riskportal.css" asp-append-version="true" />
</head>
<body>
    <div id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="logo">
                <i class="bi bi-shield-check"></i> RiskPortal
            </div>
            <div class="nav flex-column mt-3">
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>
                <a class="nav-link" asp-controller="Solicitudes" asp-action="Create">
                    <i class="bi bi-file-earmark-plus"></i> Nueva Solicitud
                </a>
                <a class="nav-link" asp-controller="Solicitudes" asp-action="Index">
                    <i class="bi bi-list-columns"></i> Solicitudes
                </a>
                <a class="nav-link" asp-controller="Clientes" asp-action="Index">
                    <i class="bi bi-people"></i> Clientes
                </a>
                @if (User.IsInRole("Analista"))
                {
                    <a class="nav-link text-warning" asp-controller="Analista" asp-action="Index">
                        <i class="bi bi-shield-lock"></i> Panel Analista
                    </a>
                }
            </div>
            
            <!-- Perfil Usuario -->
            <div class="user-profile d-flex align-items-center mt-auto justify-content-between">
                <div class="d-flex align-items-center overflow-hidden">
                    <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "U")&background=F27121&color=fff" class="rounded-circle me-3" width="40" alt="Avatar">
                    <div class="text-truncate pe-2">
                        <h6 class="mb-0 text-white text-truncate" style="max-width: 120px;" title="@User.Identity?.Name">@(User.Identity?.Name ?? "Invitado")</h6>
                        <small class="text-muted">@(User.IsInRole("Analista") ? "Analista Riesgo" : "Cliente")</small>
                    </div>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="m-0 p-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary border-0 text-white" title="Cerrar Sesión"><i class="bi bi-box-arrow-right fs-5"></i></button>
                    </form>
                }
            </div>
        </nav>

        <!-- Main Content -->
        <div id="content-wrapper">
            <header class="topbar d-flex align-items-center justify-content-between">
                <div class="search-bar w-50">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted-soft"></i></span>
                        <input type="text" class="form-control bg-light border-0" placeholder="Buscar solicitud, cliente, DNI...">
                    </div>
                </div>
                <div class="topbar-actions d-flex align-items-center">
                @{
                    var ultimoId = HttpAccessor.HttpContext?.Session.GetString("UltimaSolicitudId");
                    var ultimoMonto = HttpAccessor.HttpContext?.Session.GetString("UltimaSolicitudMonto");
                }
                @if (!string.IsNullOrEmpty(ultimoId))
                {
                    <a asp-controller="Solicitudes" asp-action="Details" asp-route-id="@ultimoId" class="text-decoration-none me-4 fw-bold" style="color: var(--rp-orange);">
                        <i class="bi bi-clock-history"></i> Ver última solicitud @ultimoMonto
                    </a>
                }
                    <a href="#" class="text-muted fs-5 me-4 position-relative">
                        <i class="bi bi-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                    </a>
                    <a asp-controller="Solicitudes" asp-action="Create" class="btn btn-primary-orange rounded-pill px-4">
                        <i class="bi bi-plus-lg"></i> Nueva Solicitud
                    </a>
                </div>
            </header>

            <main role="main" class="p-4 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>