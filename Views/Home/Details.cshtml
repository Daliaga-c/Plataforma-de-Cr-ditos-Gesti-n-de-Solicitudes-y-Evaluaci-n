@{
    ViewData["Title"] = "Detalle Solicitud #REQ-8091";
}

<!-- Cabecera -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h3 class="fw-bold mb-0">Solicitud #REQ-8091</h3>
            <span class="badge bg-warning text-dark fs-6">Pendiente</span>
        </div>
        <p class="text-muted-soft mt-1 mb-0">Cliente: María González | Registrado: 24 Abr, 2026</p>
    </div>
    <div>
        <button class="btn btn-outline-danger me-2"><i class="bi bi-x-circle"></i> Rechazar</button>
        <button class="btn btn-success"><i class="bi bi-check-circle"></i> Aprobar Crédito</button>
    </div>
</div>

<div class="row g-4">
    <!-- Panel Principal Izquierdo -->
    <div class="col-lg-8">
        <!-- Resumen Montos y Score -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card p-4 h-100">
                    <h6 class="fw-bold text-muted-soft mb-3">Resumen del Crédito</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Monto Solicitado:</span>
                        <span class="fw-bold">$15,000.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Plazo:</span>
                        <span class="fw-bold">24 Meses</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tasa Sugerida:</span>
                        <span class="fw-bold text-success">14.5% EA</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Cuota Estimada:</span>
                        <span class="fw-bold fs-5">$725.50</span>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card p-4 h-100 text-center d-flex justify-content-center align-items-center">
                    <h6 class="fw-bold text-muted-soft mb-3 align-self-start w-100 text-start">Score de Riesgo</h6>
                    <div class="position-relative d-inline-block">
                        <!-- Círculo que representa el Score -->
                        <div class="rounded-circle border border-4 border-warning d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <h2 class="mb-0 fw-bold text-warning">B2</h2>
                        </div>
                    </div>
                    <p class="mt-3 text-muted">Nivel de riesgo <strong>Moderado</strong>. Capacidad de pago cubre el 45% de sus ingresos libres.</p>
                </div>
            </div>
        </div>

        <!-- Checklist Documentos -->
        <div class="card p-4">
            <h6 class="fw-bold text-muted-soft mb-4">Documentación Adjunta</h6>
            <ul class="list-group list-group-flush">
                <li class="list-group-item px-0 d-flex justify-content-between align-items-center py-3 border-light">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-pdf text-danger fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold">DNI_Frontal_Reverso.pdf</h6>
                            <small class="text-muted">Subido hace 2 días</small>
                        </div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill me-1"></i> Verificado</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between align-items-center py-3 border-light">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-word text-primary fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold">Certificado_Ingresos.docx</h6>
                            <small class="text-muted">Subido hace 2 días</small>
                        </div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill me-1"></i> Verificado</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between align-items-center py-3 border-light">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-pdf text-danger fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold">Reporte_Buro_Credito.pdf</h6>
                            <small class="text-muted">Generado automáticamente</small>
                        </div>
                    </div>
                    <a href="#" class="btn btn-sm btn-outline-primary">Ver Documento</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Timeline Lateral Derecho -->
    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <h6 class="fw-bold text-muted-soft mb-4">Historial de Solicitud</h6>
            <ul class="timeline m-0 p-0">
                <li class="timeline-item pb-3">
                    <div class="position-absolute bg-warning rounded-circle" style="left: -5px; width: 12px; height: 12px; top: 5px;"></div>
                    <h6 class="fw-bold mb-1">En Evaluación</h6>
                    <p class="text-muted small mb-0">Analista Riesgo asignado - 24 Abr, 09:30 AM</p>
                </li>
                <li class="timeline-item">
                    <div class="position-absolute bg-primary rounded-circle" style="left: -5px; width: 12px; height: 12px; top: 5px;"></div>
                    <h6 class="fw-bold mb-1">Solicitud Registrada</h6>
                    <p class="text-muted small mb-0">Por Asesor Comercial - 24 Abr, 08:15 AM</p>
                </li>
            </ul>
        </div>
    </div>
</div>