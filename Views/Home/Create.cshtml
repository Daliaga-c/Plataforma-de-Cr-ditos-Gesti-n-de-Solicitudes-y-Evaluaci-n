@{
    ViewData["Title"] = "Nueva Solicitud";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h3 class="fw-bold">Registrar Solicitud</h3>
            <p class="text-muted-soft">Complete los datos para iniciar la evaluación crediticia.</p>
        </div>

        <div class="card p-4">
            <form asp-controller="Solicitudes" asp-action="Create" method="post">
                <!-- Paso 1 -->
                <h5 class="fw-bold mb-3 text-primary" style="color: var(--rp-orange) !important;">1. Selección de Cliente</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">DNI / RUC</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-light border-0 py-2" placeholder="Ingrese documento">
                            <button class="btn btn-outline-secondary" type="button"><i class="bi bi-search"></i> Buscar</button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control bg-light border-0 py-2" placeholder="Autocompletado" readonly>
                    </div>
                </div>

                <hr class="text-muted-soft opacity-25 my-4">

                <!-- Paso 2 -->
                <h5 class="fw-bold mb-3 text-primary" style="color: var(--rp-orange) !important;">2. Datos del Crédito</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Monto Solicitado</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">$</span>
                            <input type="number" class="form-control bg-light border-0 py-2" placeholder="0.00">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Plazo (Meses)</label>
                        <select class="form-select bg-light border-0 py-2">
                            <option value="12">12 meses</option>
                            <option value="24">24 meses</option>
                            <option value="36">36 meses</option>
                            <option value="48">48 meses</option>
                            <option value="60">60 meses</option>
                        </select>
                    </div>
                </div>

                <hr class="text-muted-soft opacity-25 my-4">

                <!-- Paso 3 -->
                <h5 class="fw-bold mb-3 text-primary" style="color: var(--rp-orange) !important;">3. Ingresos y Capacidad de Pago</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ingresos Mensuales Netos</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">$</span>
                            <input type="number" class="form-control bg-light border-0 py-2" placeholder="0.00">
                        </div>
                    </div>
                </div>

                <div class="text-end mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-light me-2">Cancelar</button>
                    <button type="submit" class="btn btn-primary-orange px-4">Procesar Solicitud <i class="bi bi-arrow-right ms-2"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>