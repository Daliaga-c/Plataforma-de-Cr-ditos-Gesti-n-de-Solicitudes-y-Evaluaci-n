@model RiskPortal.Models.SolicitudCredito
@{
    ViewData["Title"] = $"Detalle Solicitud #REQ-{Model.Id.ToString("D4")}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h3 class="fw-bold mb-0">Solicitud #REQ-@Model.Id.ToString("D4")</h3>
            <span class="badge @(Model.Estado == RiskPortal.Models.EstadoSolicitud.Aprobado ? "bg-success" : Model.Estado == RiskPortal.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark") fs-6">
                @Model.Estado
            </span>
        </div>
        <p class="text-muted-soft mt-1 mb-0">Cliente: @(Model.Cliente?.UsuarioId ?? "Desconocido") | Registrado: @Model.FechaSolicitud.ToString("dd MMM, yyyy")</p>
    </div>
    
    @if (Model.Estado == RiskPortal.Models.EstadoSolicitud.Pendiente && User.IsInRole("Analista"))
    {
        <div class="d-flex gap-2">
            <form asp-controller="Solicitudes" asp-action="CambiarEstado" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="Rechazado" />
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Rechazar</button>
            </form>
            <form asp-controller="Solicitudes" asp-action="CambiarEstado" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="Aprobado" />
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Aprobar Crédito</button>
            </form>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card p-4 h-100">
                    <h6 class="fw-bold text-muted-soft mb-3">Resumen Financiero</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Monto Solicitado:</span>
                        <span class="fw-bold">@Model.MontoSolicitado.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Ingresos Cliente:</span>
                        <span class="fw-bold">@(Model.Cliente?.IngresosMensuales.ToString("C") ?? "0.00")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Capacidad de Pago:</span>
                        @if(Model.CumpleCapacidadPago())
                        {
                            <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill"></i> Cumple</span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle-fill"></i> Excede Límite</span>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card p-4 h-100 text-center d-flex justify-content-center align-items-center">
                    <h6 class="fw-bold text-muted-soft mb-3 align-self-start w-100 text-start">Score del Sistema</h6>
                    <div class="position-relative d-inline-block">
                        <div class="rounded-circle border border-4 @(Model.CumpleCapacidadPago() ? "border-success" : "border-danger") d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <h2 class="mb-0 fw-bold @(Model.CumpleCapacidadPago() ? "text-success" : "text-danger")">
                                @(Model.CumpleCapacidadPago() ? "A1" : "C3")
                            </h2>
                        </div>
                    </div>
                    <p class="mt-3 text-muted">
                        @(Model.CumpleCapacidadPago() ? "El cliente tiene excelente capacidad para absorber la deuda." : "Riesgo alto: La solicitud supera el límite permitido de su ingreso x 5.")
                    </p>
                </div>
            </div>
        </div>
        
        @if(!string.IsNullOrEmpty(Model.MotivoRechazo))
        {
            <div class="alert alert-danger">
                <strong>Motivo de Rechazo:</strong> @Model.MotivoRechazo
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <h6 class="fw-bold text-muted-soft mb-4">Línea de Tiempo</h6>
            <ul class="timeline m-0 p-0">
                <li class="timeline-item pb-3">
                    <div class="position-absolute @(Model.Estado == RiskPortal.Models.EstadoSolicitud.Pendiente ? "bg-warning" : "bg-secondary") rounded-circle" style="left: -5px; width: 12px; height: 12px; top: 5px;"></div>
                    <h6 class="fw-bold mb-1">Estado Actual: @Model.Estado</h6>
                    <p class="text-muted small mb-0">Sistema RiskPortal</p>
                </li>
            </ul>
        </div>
    </div>
</div>