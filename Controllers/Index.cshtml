@model IEnumerable<RiskPortal.Models.SolicitudCredito>
@{
    ViewData["Title"] = "Panel de Evaluación - Analista";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-shield-lock" style="color: var(--rp-orange);"></i> Panel de Evaluación</h3>
        <p class="text-muted-soft mt-1 mb-0">Gestión de solicitudes en espera (Estado: Pendiente)</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-3 mb-4 fw-bold"><i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger rounded-3 mb-4 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted-soft">
                    <tr>
                        <th class="ps-4">ID Solicitud</th>
                        <th>Cliente</th>
                        <th>Monto</th>
                        <th>Regla 5x Ingresos</th>
                        <th>Fecha</th>
                        <th class="text-end pe-4">Decisión</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No hay solicitudes pendientes por evaluar. ¡Todo al día!</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#REQ-@item.Id.ToString("D4")</td>
                            <td>@(item.Cliente?.UsuarioId ?? "Desconocido")</td>
                            <td class="fw-bold">@item.MontoSolicitado.ToString("C")</td>
                            <td>
                                @if(item.CumpleCapacidadPago()) { <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill"></i> Cumple límite</span> }
                                else { <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle-fill"></i> Excede límite</span> }
                            </td>
                            <td>@item.FechaSolicitud.ToString("dd MMM, yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <!-- Botón Aprobar (Se desactiva si excede la regla de negocio) -->
                                    <form asp-action="Aprobar" method="post" onsubmit="return confirm('¿Confirma la APROBACIÓN de este crédito?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success" @(!item.CumpleCapacidadPago() ? "disabled title='Excede capacidad'" : "")><i class="bi bi-check-lg"></i> Aprobar</button>
                                    </form>
                                    <!-- Botón Rechazar (Abre modal) -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rechazarModal-@item.Id"><i class="bi bi-x-lg"></i> Rechazar</button>
                                </div>

                                <!-- Modal de Rechazo -->
                                <div class="modal fade" id="rechazarModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content text-start">
                                            <form asp-action="Rechazar" method="post">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold">Rechazar #REQ-@item.Id.ToString("D4")</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Motivo del rechazo <span class="text-danger">*</span></label>
                                                        <textarea name="motivoRechazo" class="form-control bg-light border-0" rows="3" required placeholder="Ej: Historial crediticio insuficiente..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-danger">Confirmar Rechazo</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>