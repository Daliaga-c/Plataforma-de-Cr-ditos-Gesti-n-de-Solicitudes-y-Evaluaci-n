@model RiskPortal.Models.CreateSolicitudViewModel
@{
    ViewData["Title"] = "Nueva Solicitud";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-0">Registrar Solicitud</h3>
                <p class="text-muted-soft mt-1 mb-0">Complete los datos para iniciar la evaluación crediticia.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-list-ul"></i> Volver al Catálogo</a>
        </div>

        <!-- Feedback Claro de Éxito -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-3 mb-4 fw-bold">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <!-- Feedback Claro de Errores Server-Side -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger rounded-3 mb-4">
                <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> No se pudo procesar la solicitud:</h6>
                <div asp-validation-summary="All" class="mb-0 list-unstyled small"></div>
            </div>
        }

        <div class="card p-4">
            <form asp-action="Create" method="post">
                <!-- Paso 1 -->
                <h5 class="fw-bold mb-3" style="color: var(--rp-orange);">1. Selección de Cliente</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label asp-for="ClienteId" class="form-label fw-bold"></label>
                        <select asp-for="ClienteId" class="form-select bg-light border-0 py-2" asp-items="ViewBag.Clientes">
                            <option value="">-- Seleccione el cliente a evaluar --</option>
                        </select>
                    </div>
                </div>
                <hr class="text-muted-soft opacity-25 my-4">

                <!-- Paso 2 -->
                <h5 class="fw-bold mb-3" style="color: var(--rp-orange);">2. Datos del Crédito</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label asp-for="MontoSolicitado" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">$</span>
                            <input asp-for="MontoSolicitado" type="number" step="0.01" class="form-control bg-light border-0 py-2" placeholder="0.00">
                        </div>
                    </div>
                </div>

                <div class="text-end mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary-orange px-4">Procesar Solicitud <i class="bi bi-arrow-right ms-2"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>